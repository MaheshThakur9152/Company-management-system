<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="24dp"
            android:gravity="center_vertical"
            android:background="@color/white">

            <ImageButton
                android:id="@+id/back_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/circle_slate_bg"
                android:src="@drawable/ic_chevron_left"
                app:tint="@color/slate_600" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Bills &amp; Invoices"
                android:textSize="18sp"
                android:textColor="@color/slate_800"
                android:fontFamily="sans-serif-black"
                android:gravity="center" />

            <ImageButton
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/circle_orange_light_bg"
                android:src="@drawable/ic_plus"
                app:tint="@color/orange_500" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Tab Layout -->
            <!-- Custom Switch Tab -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/rounded_white"
                android:padding="4dp"
                android:layout_marginBottom="32dp">

                <TextView
                    android:id="@+id/tab_unpaid"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Unpaid Bills"
                    android:paddingVertical="12dp"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:background="@drawable/rounded_orange_bg"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tab_paid"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Paid History"
                    android:paddingVertical="12dp"
                    android:gravity="center"
                    android:textColor="@color/slate_500"
                    android:background="@null"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Total Amount -->
            <TextView
                android:id="@+id/total_label_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TOTAL OUTSTANDING"
                android:textSize="11sp"
                android:textColor="@color/slate_500"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.08"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/total_amount_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹ 22,100"
                android:textSize="30sp"
                android:textColor="@color/slate_800"
                android:fontFamily="sans-serif-black"
                android:layout_marginBottom="24dp" />

            <!-- Bills RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/bills_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
