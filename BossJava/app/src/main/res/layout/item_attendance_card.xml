<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Card Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <!-- Avatar (Square) -->
            <FrameLayout
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginEnd="12dp">
                
                <View
                    android:id="@+id/card_avatar_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_avatar_square"/>
                
                <TextView
                    android:id="@+id/card_avatar_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="SU"
                    android:textSize="18sp"
                    android:textColor="#111827"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-black"/>
            </FrameLayout>

            <!-- Name & Role -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/card_employee_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Suman"
                    android:textSize="18sp"
                    android:textColor="#111827"
                    android:fontFamily="sans-serif-black"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="2dp">
                    
                    <TextView
                        android:id="@+id/card_site_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OFFICE"
                        android:textSize="12sp"
                        android:textColor="#6B7280"
                        android:fontFamily="sans-serif-bold"
                        android:textAllCaps="true"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" • "
                        android:textColor="#6B7280"/>

                    <TextView
                        android:id="@+id/card_role"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="STAFF"
                        android:textSize="12sp"
                        android:textColor="#9CA3AF"
                        android:fontFamily="sans-serif-bold"
                        android:textAllCaps="true"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Status Pill -->
            <TextView
                android:id="@+id/card_status_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PENDING"
                android:textSize="11sp"
                android:textColor="#6B7280"
                android:fontFamily="sans-serif-black"
                android:background="@drawable/bg_pending_pill"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"/>
        </LinearLayout>

        <!-- Main Content Area -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="400dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#F8FAFC">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- 1. The Photo (Visible if Present) -->
                <ImageView
                    android:id="@+id/card_photo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:background="#F3F4F6"
                    android:visibility="gone"/>

                <!-- 2. No Log Found / Pending State (Visible if Absent/No Data) -->
                <LinearLayout
                    android:id="@+id/card_no_log_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:visibility="visible">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="64dp"
                        android:src="@drawable/ic_user" 
                        app:tint="#CBD5E1"
                        android:layout_marginBottom="16dp"/>
                        <!-- Using generic user icon as placeholder for the ID card icon -->
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NO LOG FOUND"
                        android:textColor="#94A3B8"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-black"
                        android:textAllCaps="true"
                        android:letterSpacing="0.05"/>
                </LinearLayout>

                <!-- 3. Overlays (Visible if Present) -->
                <LinearLayout
                    android:id="@+id/card_overlays"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:padding="16dp"
                    android:orientation="horizontal"
                    android:visibility="gone">
                    <!-- ... Same as before ... -->
                </LinearLayout>
                
                <!-- 4. Add Button Overlay (Floating on image lower right) -->
                <ImageButton
                    android:id="@+id/card_add_btn"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="16dp"
                    android:background="@drawable/circle_slate_bg" 
                    android:backgroundTint="#111827"
                    android:src="@drawable/ic_plus"
                    app:tint="@color/white"
                    android:padding="10dp"/>

            </FrameLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</androidx.cardview.widget.CardView>
