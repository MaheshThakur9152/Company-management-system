<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="32dp"
    android:paddingBottom="32dp"
    android:background="@drawable/rounded_white"
    android:gravity="center_horizontal">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="#E5E7EB"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SELECT CALENDAR VIEW"
        android:textSize="18sp"
        android:textColor="#111827"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.05"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SELECT YEAR"
        android:textSize="12sp"
        android:textColor="#9CA3AF"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.1"
        android:layout_marginBottom="12dp"/>

    <!-- Year Selector -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="32dp">

        <TextView
            android:id="@+id/year_2024"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="2024"
            android:textColor="#9CA3AF"
            android:background="@drawable/bg_date_inactive"
            android:fontFamily="sans-serif-black"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/year_2025"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="2025"
            android:textColor="#9CA3AF"
            android:background="@drawable/bg_date_inactive"
            android:fontFamily="sans-serif-black"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/year_2026"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="2026"
            android:textColor="@color/white"
            android:background="@drawable/bg_dark_button"
            android:fontFamily="sans-serif-black"/>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SELECT MONTH"
        android:textSize="12sp"
        android:textColor="#9CA3AF"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.1"
        android:layout_marginBottom="12dp"/>

    <!-- Month Grid -->
    <GridLayout
        android:id="@+id/month_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:alignmentMode="alignMargins"
        android:columnOrderPreserved="false"
        android:useDefaultMargins="true">
        <!-- Added programmatically or standard XML -->
        <!-- Doing simplistic approach for main months used in demo -->
    </GridLayout>

</LinearLayout>
