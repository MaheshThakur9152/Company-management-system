<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="64dp"
    android:orientation="horizontal"
    android:background="@color/white"
    android:gravity="center_vertical">

    <!-- Employee Info Column (Fixed Width) -->
    <LinearLayout
        android:layout_width="180dp"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:gravity="center_vertical"
        android:background="@color/white">

        <!-- Avatar Circle -->
        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp">

            <View
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/circle_yellow_bg" />

            <TextView
                android:id="@+id/avatar_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="SU"
                android:textSize="14sp"
                android:textColor="@color/slate_700"
                android:fontFamily="sans-serif-black" />
        </FrameLayout>

        <!-- Employee Name and Site -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/employee_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Suman"
                android:textSize="14sp"
                android:textColor="@color/slate_800"
                android:fontFamily="sans-serif-black"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/employee_site"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="#1234 • Office"
                android:textSize="10sp"
                android:textColor="@color/slate_500"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Attendance Days Container (Horizontally Scrollable Content) -->
    <LinearLayout
        android:id="@+id/attendance_days_container"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="horizontal">
        <!-- Days will be added programmatically -->
    </LinearLayout>

</LinearLayout>
